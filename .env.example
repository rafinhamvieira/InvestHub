# ============================================================
# InvestHub — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env.
# ============================================================

# App
NODE_ENV=production

# Domínio público que aponta para o servidor (registro A no DNS, ou um subdomínio DuckDNS).
# Usado pelo nginx e pelo Let's Encrypt — sem "https://" e sem barra final.
APP_DOMAIN=investhub.duckdns.org

# URL completa da aplicação (deve casar com APP_DOMAIN).
APP_URL=https://investhub.duckdns.org

# HTTPS / Let's Encrypt — apenas para avisos de expiração do certificado.
LETSENCRYPT_EMAIL=voce@exemplo.com
# 1 = usa o ambiente de teste (certificado não confiável, sem limite de tentativas).
# Deixe vazio ou 0 para emitir o certificado real.
LETSENCRYPT_STAGING=0

# Banco de dados (PostgreSQL)
POSTGRES_USER=investhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=investhub
DATABASE_URL=postgresql://investhub:change-me-strong-password@postgres:5432/investhub?schema=public

# Redis (cache / rate limit)
REDIS_URL=redis://redis:6379

# Auth.js
# Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_URL=https://investhub.duckdns.org
AUTH_TRUST_HOST=true

# Criptografia de segredos sensíveis (ex: chave TOTP do 2FA)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-key

# E-mail transacional (confirmação de cadastro, recuperação de senha)
EMAIL_FROM="InvestHub <no-reply@investhub.app>"
RESEND_API_KEY=replace-with-resend-api-key

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Segredo para o job de integrações avaliar alertas de todos os usuários (POST /api/alerts/evaluate)
# Gere com: openssl rand -hex 24
CRON_SECRET=

# Provedor de dados de mercado — brapi.dev (crie um token gratuito em https://brapi.dev)
# Sem token, as chamadas ainda funcionam com limites bem menores.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://brapi.dev/api

# IA (fase futura — assistente opcional)
OPENAI_API_KEY=

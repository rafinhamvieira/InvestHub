# ============================================================
# InvestHub — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env.
# ============================================================

# App
NODE_ENV=production

# Domínio público que aponta para o servidor (registro A no DNS, ou um subdomínio DuckDNS).
# Usado pelo nginx e pelo Let's Encrypt — sem "https://" e sem barra final.
APP_DOMAIN=investhub.duckdns.org

# URL pública completa. Inclua a porta se o acesso não for pela 443
# (ex: https://investhub.duckdns.org:8080 quando o provedor bloqueia a 443).
APP_URL=https://investhub.duckdns.org

# Portas publicadas pelo Docker no servidor.
HTTPS_PORT=443
HTTP_PORT=80

# HTTPS / Let's Encrypt — apenas para avisos de expiração do certificado.
LETSENCRYPT_EMAIL=voce@exemplo.com

# Método de validação do certificado:
#   http — desafio na porta 80 (padrão; exige a 80 acessível pela internet)
#   dns  — registro TXT no DuckDNS (não precisa de porta aberta; só para domínios *.duckdns.org)
CERT_MODE=http

# Token do DuckDNS — obrigatório quando CERT_MODE=dns.
DUCKDNS_TOKEN=

# Segundos de espera pela propagação do registro TXT antes de o Let's Encrypt consultar.
# Aumente para 60 se a validação falhar com "Incorrect TXT record".
DUCKDNS_PROPAGATION_SECONDS=30
# 1 = usa o ambiente de teste (certificado não confiável, sem limite de tentativas).
# Deixe vazio ou 0 para emitir o certificado real.
LETSENCRYPT_STAGING=0

# Banco de dados (PostgreSQL)
POSTGRES_USER=investhub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=investhub
DATABASE_URL=postgresql://investhub:change-me-strong-password@postgres:5432/investhub?schema=public

# Redis (cache / rate limit)
REDIS_URL=redis://redis:6379

# Auth.js
# Gere com: openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-secret
AUTH_URL=https://investhub.duckdns.org
AUTH_TRUST_HOST=true

# Criptografia de segredos sensíveis (ex: chave TOTP do 2FA)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-key

# E-mail transacional (confirmação de cadastro, recuperação de senha)
# Provedor: "smtp" ou "resend". Vazio = deduzido pelas credenciais presentes (SMTP primeiro).
EMAIL_PROVIDER=smtp

# Remetente. No Gmail precisa ser a própria conta autenticada.
EMAIL_FROM="InvestHub <voce@gmail.com>"

# --- SMTP (Gmail, Zoho, Outlook, servidor próprio...) ---
# Para o Gmail, SMTP_PASSWORD é uma "senha de app" de 16 caracteres gerada em
# https://myaccount.google.com/apppasswords (exige verificação em duas etapas ativa).
# Limite prático do Gmail: ~500 destinatários por dia.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=
# Opcional: por padrão, TLS implícito na porta 465 e STARTTLS nas demais.
# SMTP_SECURE=false
# --- Resend (alternativa ao SMTP) ---
# Sem um domínio verificado em resend.com/domains, só entrega no e-mail dono da conta.
RESEND_API_KEY=

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Segredo para o job de integrações avaliar alertas de todos os usuários (POST /api/alerts/evaluate)
# Gere com: openssl rand -hex 24
CRON_SECRET=

# Provedor de dados de mercado — brapi.dev (crie um token gratuito em https://brapi.dev)
# Sem token, as chamadas ainda funcionam com limites bem menores.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://brapi.dev/api

# Ativos por requisição. O plano gratuito da brapi aceita apenas 1 — pedir mais
# devolve erro. Aumente somente se o seu plano permitir.
MARKET_DATA_BATCH_SIZE=1
# Pausa entre requisições, em milissegundos.
MARKET_DATA_DELAY_MS=400

# Intervalo do job de sincronização, em segundos. Cada ativo consome uma requisição
# por ciclo: reduza a frequência se estiver perto do limite do seu plano.
SYNC_INTERVAL_SECONDS=1800

# Ativos que têm os fundamentos atualizados por ciclo (fila rotativa que cobre o mercado
# aos poucos). 4 por ciclo de 30 min dão ~192 chamadas/dia — o teto do plano grátis do
# Bolsai é 200. Só aumente junto com o plano.
FUNDAMENTALS_PER_CYCLE=4

# Ativos que têm os proventos importados por ciclo. Fonte gratuita (B3 + Yahoo): o limite
# aqui é educação com quem hospeda os dados, não cota.
DIVIDENDS_PER_CYCLE=10

# Vigia da sincronização: quantas falhas seguidas disparam aviso aos administradores, e
# depois de quantas horas sem sucesso o job é considerado parado.
SYNC_FAILURE_THRESHOLD=3
SYNC_STALE_HOURS=3

# Backup automático do banco (serviço "backup" do compose). Os dumps ficam em ./backups,
# fora dos volumes do Docker — backup no mesmo volume do banco não sobrevive ao acidente
# que deveria cobrir.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# Fundamentos (Bolsai — https://usebolsai.com). Fonte: B3, CVM e BCB.
# Plano grátis: 200 req/dia, com indicadores de ações e cadastro completo de FIIs
# (P/VP, dividend yield, vacância, segmento). Sem chave, o sistema segue só com cotações.
BOLSAI_API_KEY=
BOLSAI_BASE_URL=https://api.usebolsai.com/api/v1

# IA (fase futura — assistente opcional)
OPENAI_API_KEY=

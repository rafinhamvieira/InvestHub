# next-auth@5.0.0-beta.25 declara peerOptional nodemailer@^6.6.5, enquanto o @auth/core que
# ele mesmo traz declara ^7.0.7 || ^8.0.5 — faixas incompatíveis entre si. Como o nodemailer
# é opcional para os dois (só o usamos diretamente, em src/lib/email.ts), afrouxamos a
# resolução de peers para que a instalação seja possível e reprodutível.
legacy-peer-deps=true

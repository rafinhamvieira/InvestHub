// InvestHub — Schema do banco de dados
// Domínios: Identidade/Auth · Mercado (dados mestres) · Carteira do usuário · Planejamento · Acompanhamento

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

/// Cargos da plataforma. A autorização nunca compara papéis diretamente: quem decide é o
/// mapa de permissões em `src/lib/permissions.ts`. Cargo novo entra lá, não no código das telas.
enum Role {
  USER
  /// Somente leitura das telas administrativas.
  READ_ONLY
  /// Auditoria: lê trilha e central de segurança, não altera nada.
  AUDITOR
  /// Suporte: age sobre contas de usuário, sem tocar em plataforma nem backup.
  SUPPORT
  ADMIN
  /// Único que gerencia cargos, restaura backup e verifica a integridade da trilha.
  SUPER_ADMIN
}

/// Origem da sessão — hoje só Web; os demais existem para o app e a API futura.
enum SessionType {
  WEB
  MOBILE
  API
}

enum RiskProfile {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
  CUSTOM
}

enum AssetType {
  STOCK
  FII
  ETF
  BDR
  /// Tesouro Direto — risco soberano.
  TREASURY
  /// Renda fixa privada: CDB, LCI, LCA, CRI, CRA, debênture.
  FIXED_INCOME
}

/// Índice que corrige o título. PREFIXADO não tem índice: a taxa é toda no spread.
enum FixedIncomeIndexer {
  SELIC
  CDI
  IPCA
  PREFIXADO
}

enum TransactionType {
  BUY
  SELL
}

enum AllocationTargetLevel {
  CLASS
  SECTOR
  ASSET
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  DIVIDEND_YIELD_ABOVE
  PL_BELOW
  FAIR_PRICE_MARGIN_REACHED
  NEW_DIVIDEND_DECLARED
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum ValuationMethod {
  GRAHAM
  BAZIN
  LYNCH
  GREENBLATT
  DCF
  CUSTOM
}

// ============================================================
// IDENTIDADE / AUTENTICAÇÃO
// ============================================================

model User {
  id                 String      @id @default(cuid())
  name               String?
  email              String      @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               Role        @default(USER)
  riskProfile        RiskProfile @default(MODERATE)
  currency           String      @default("BRL")
  locale             String      @default("pt-BR")
  theme              String      @default("system")
  emailNotifications Boolean     @default(true)

  /// Tokens emitidos antes desta data param de valer — é o que faz "forçar logout" em bloco
  /// funcionar com sessão apátrida.
  sessionsValidFrom DateTime?

  twoFactorEnabled       Boolean  @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  loginAudits          LoginAudit[]
  // Sem relação com `AuditLog`: a trilha guarda o id sem chave estrangeira, para que
  // excluir a conta não precise alterá-la. Ver o comentário no modelo `AuditLog`.
  userSessions         UserSession[]
  brokers              Broker[]
  transactions         Transaction[]
  positions            Position[]
  dividendReceipts     DividendReceipt[]
  allocationTargets    AllocationTarget[]
  watchlists           Watchlist[]
  alerts               Alert[]
  notifications        Notification[]
  scoreWeight          ScoreWeight?
  valuationAssumptions ValuationAssumption[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Registro de toda tentativa de login (sucesso ou falha) para auditoria e detecção de abuso.
model LoginAudit {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@map("login_audits")
}

/// Trilha de auditoria — **append-only**.
///
/// Não existe caminho de alteração: o banco recusa UPDATE e DELETE por trigger, o
/// repositório só expõe `append()` e nenhuma rota escreve aqui sem passar pelo
/// `auditService`. Correção de um registro errado é um registro novo, nunca uma edição.
///
/// `seq`, `prevHash` e `hash` formam a cadeia de integridade, calculada dentro do banco:
/// vale para qualquer caminho de escrita, inclusive INSERT manual no psql.
///
/// E-mails de autor e alvo ficam denormalizados de propósito. As chaves estrangeiras usam
/// SET NULL — RESTRICT impediria excluir qualquer conta que já tivesse gerado log, e
/// cascata apagaria a trilha junto com o usuário. Com o e-mail na própria linha, o
/// registro continua legível depois que a conta some.
model AuditLog {
  id  String @id @default(cuid())
  seq BigInt @unique @default(autoincrement())

  action String
  /// SUCCESS | FAILED
  result String @default("SUCCESS")

  /// Quem sofreu a ação. **Sem chave estrangeira, de propósito** — ver o fim do modelo.
  userId      String?
  targetEmail String?
  /// Quem executou. Igual a `userId` quando o próprio usuário agiu.
  actorId     String?
  actorEmail  String?

  sessionId String?
  entity    String?
  entityId  String?
  /// Justificativa — obrigatória nas ações marcadas como críticas.
  reason    String?
  notes     String?
  metadata  Json?

  ipAddress String?
  userAgent String?

  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())

  /// Não há relação com `User`, e a ausência é a decisão.
  ///
  /// Com `onDelete: SetNull`, excluir uma conta fazia o Postgres **atualizar** esta tabela —
  /// e o trigger de imutabilidade recusa qualquer UPDATE. Nenhuma conta com histórico podia
  /// ser excluída, o que na prática era toda conta, porque o cadastro já gera registro.
  ///
  /// Permitir o UPDATE seria pior: `userId` e `actorId` entram no payload assinado, então
  /// anulá-los quebraria a cadeia de hash e a verificação acusaria adulteração onde houve
  /// apenas o exercício de um direito do usuário.
  ///
  /// O id continua na coluna e o e-mail denormalizado mantém a linha legível depois que a
  /// conta some. Quem precisa do nome atual resolve por consulta, no repositório.

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("audit_logs")
}

/// Amostra periódica da saúde da plataforma, coletada pelo healthcheck do Docker.
///
/// O resumo da Etapa 2 responde "como está agora"; esta tabela responde "como esteve".
/// A coleta pega carona no `/api/health`, que o Docker já chama a cada 15 segundos — o
/// mesmo truque que o vigia da sincronização usa para não precisar de agendador próprio.
///
/// **Buraco na série é registro de queda.** Com o banco fora do ar não há como gravar a
/// amostra que diria isso; a ausência dela no gráfico é o que conta a história.
model HealthSample {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Pior estado entre as verificações no momento da amostra: ok | warn | down.
  status String

  /// Tempo de resposta em milissegundos. Nulo quando a sondagem falhou.
  databaseMs Int?
  cacheMs    Int?

  /// Horas desde o último sucesso da sincronização; nulo quando nunca houve.
  syncAgeHours Float?
  /// Falhas seguidas acumuladas até o momento da amostra.
  syncFailures Int    @default(0)
  /// Horas desde o backup mais recente; nulo quando não há nenhum.
  backupAgeHours Float?

  /// Fração de 0 a 1 dos ativos com fundamentos — o avanço da rotação, dia a dia.
  coverage Float?
  /// Segundos no ar do processo. Queda no valor denuncia reinício.
  uptimeSeconds Int @default(0)

  @@index([createdAt])
  @@map("health_samples")
}

/// Âncora periódica da cadeia de auditoria.
///
/// Guarda o HMAC do hash de cabeça com uma chave que vive só no ambiente, nunca no banco.
/// Recalcular a cadeia inteira para esconder um evento exigiria também essa chave.
model AuditCheckpoint {
  id        String   @id @default(cuid())
  seq       BigInt
  headHash  String
  hmac      String
  createdAt DateTime @default(now())

  @@index([seq])
  @@map("audit_checkpoints")
}

/// Sessão de acesso. O Auth.js opera com JWT, que é apátrida — este registro é o que
/// permite listar, revogar e auditar sessões.
model UserSession {
  id     String      @id @default(cuid())
  userId String
  type   SessionType @default(WEB)

  ipAddress   String?
  userAgent   String?
  browser     String?
  os          String?
  /// Cidade/região aproximada, preenchida só quando há provedor de geolocalização configurado.
  location    String?
  /// Impressão do dispositivo, quando o cliente enviar.
  fingerprint String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  revokedAt        DateTime?
  revokedBy        String?
  revocationReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================================
// MERCADO — dados mestres (alimentados por integrações, fase futura)
// ============================================================

model Asset {
  id          String    @id @default(cuid())
  ticker      String    @unique
  name        String
  type        AssetType
  sector      String?
  subsector   String?
  segment     String?
  cnpj        String?
  description String?
  logoUrl     String?
  currency    String    @default("BRL")
  isActive    Boolean   @default(true)

  /// Quando a fila de rotação tentou buscar fundamentos/proventos deste ativo — sucesso
  /// ou não. Sem isso, ativo que a fonte não cobre (BDR no provedor de fundamentos, por
  /// exemplo) volta ao início da fila para sempre e consome a cota do dia sem entregar nada.
  fundamentalsCheckedAt DateTime?
  dividendsCheckedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixedIncomeTerms     FixedIncomeTerms?
  fundamentals         AssetFundamental[]
  prices               AssetPrice[]
  dividends            AssetDividend[]
  transactions         Transaction[]
  positions            Position[]
  watchlistItems       WatchlistItem[]
  alerts               Alert[]
  allocationTargets    AllocationTarget[]
  valuationAssumptions ValuationAssumption[]

  @@index([type])
  @@index([sector])
  @@map("assets")
}

/// Série histórica de indicadores fundamentalistas (um snapshot por data de referência).
model AssetFundamental {
  id            String   @id @default(cuid())
  assetId       String
  referenceDate DateTime

  price          Decimal? @db.Decimal(18, 4)
  pl             Decimal? @db.Decimal(12, 4)
  pvp            Decimal? @db.Decimal(12, 4)
  dividendYield  Decimal? @db.Decimal(8, 4)
  roe            Decimal? @db.Decimal(8, 4)
  roic           Decimal? @db.Decimal(8, 4)
  netMargin      Decimal? @db.Decimal(8, 4)
  ebitdaMargin   Decimal? @db.Decimal(8, 4)
  evEbit         Decimal? @db.Decimal(12, 4)
  evEbitda       Decimal? @db.Decimal(12, 4)
  liquidity      Decimal? @db.Decimal(18, 2)
  tagAlong       Decimal? @db.Decimal(6, 2)
  freeFloat      Decimal? @db.Decimal(6, 2)
  revenueGrowth  Decimal? @db.Decimal(8, 4)
  earningsGrowth Decimal? @db.Decimal(8, 4)
  netDebt        Decimal? @db.Decimal(18, 2)
  netDebtEbitda  Decimal? @db.Decimal(8, 4)
  equity         Decimal? @db.Decimal(18, 2)
  marketCap      Decimal? @db.Decimal(18, 2)

  // Específico de FIIs
  vacancy              Decimal? @db.Decimal(6, 2)
  capRate              Decimal? @db.Decimal(6, 2)
  numberOfProperties   Int?
  numberOfShareholders Int?
  managerName          String?
  averageContractTerm  Decimal? @db.Decimal(8, 2)
  indexer              String?

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, referenceDate])
  @@index([assetId])
  @@map("asset_fundamentals")
}

/// Série histórica de preço (fechamento diário) para gráficos e cálculo de rentabilidade.
model AssetPrice {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime
  close     Decimal  @db.Decimal(18, 4)
  open      Decimal? @db.Decimal(18, 4)
  high      Decimal? @db.Decimal(18, 4)
  low       Decimal? @db.Decimal(18, 4)
  volume    BigInt?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
  @@map("asset_prices")
}

/// Condições de um título de renda fixa — o que substitui "cotação de mercado" nessa classe.
///
/// O título não tem preço negociado em bolsa: o valor de hoje sai da correção do indexador
/// desde a data de emissão do papel na plataforma. `startDate` é o marco dessa curva, com
/// valor unitário 1,00; a partir dele o motor calcula um preço sintético diário, e todo o
/// resto do sistema (posição, patrimônio, evolução, alocação) segue funcionando sem saber
/// que aquele preço não veio da bolsa.
model FixedIncomeTerms {
  id      String @id @default(cuid())
  assetId String @unique

  /// Banco ou emissor. "Tesouro Nacional" para títulos públicos.
  issuer  String?
  indexer FixedIncomeIndexer

  /// Percentual do índice — 110 significa 110% do CDI. Nulo para IPCA+ e prefixado.
  indexPercent  Decimal? @db.Decimal(8, 4)
  /// Juro real anual somado ao índice (IPCA + 6,00) ou taxa cheia do prefixado.
  spreadPercent Decimal? @db.Decimal(8, 4)

  /// Início da curva do papel: valor unitário 1,00 nesta data.
  startDate    DateTime
  maturityDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("fixed_income_terms")
}

/// Proventos declarados pelo ativo (dividendo, JCP, rendimento de FII).
model AssetDividend {
  id            String    @id @default(cuid())
  assetId       String
  type          String
  valuePerShare Decimal   @db.Decimal(12, 6)
  exDate        DateTime
  paymentDate   DateTime?
  declaredAt    DateTime?
  createdAt     DateTime  @default(now())

  asset    Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  receipts DividendReceipt[]

  @@index([assetId, exDate])
  @@map("asset_dividends")
}

// ============================================================
// CARTEIRA DO USUÁRIO
// ============================================================

model Broker {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("brokers")
}

/// Ledger de compras e vendas — fonte da verdade da carteira. Position é derivado disto.
model Transaction {
  id        String          @id @default(cuid())
  userId    String
  assetId   String
  brokerId  String?
  type      TransactionType
  quantity  Decimal         @db.Decimal(18, 8)
  price     Decimal         @db.Decimal(18, 4)
  fees      Decimal         @default(0) @db.Decimal(18, 4)
  date      DateTime
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  broker Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  @@index([userId, assetId])
  @@index([userId, date])
  @@map("transactions")
}

/// Posição consolidada por ativo, recalculada pelo service após cada transação (cache de leitura).
model Position {
  id            String   @id @default(cuid())
  userId        String
  assetId       String
  quantity      Decimal  @db.Decimal(18, 8)
  averagePrice  Decimal  @db.Decimal(18, 4)
  totalInvested Decimal  @db.Decimal(18, 4)
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@map("positions")
}

/// Proventos efetivamente recebidos pelo usuário, calculado ao cruzar Position com AssetDividend.
model DividendReceipt {
  id            String   @id @default(cuid())
  userId        String
  dividendId    String
  quantityHeld  Decimal  @db.Decimal(18, 8)
  totalReceived Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dividend AssetDividend @relation(fields: [dividendId], references: [id], onDelete: Cascade)

  @@unique([userId, dividendId])
  @@map("dividend_receipts")
}

// ============================================================
// PLANEJAMENTO
// ============================================================

/// Metas de alocação definidas pelo usuário, em três níveis: classe, setor ou ativo individual.
model AllocationTarget {
  id            String                @id @default(cuid())
  userId        String
  level         AllocationTargetLevel
  label         String
  assetId       String?
  targetPercent Decimal               @db.Decimal(6, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, level, label])
  @@map("allocation_targets")
}

/// Pesos personalizáveis do score de inteligência (0–100) por indicador. Soma esperada = 100.
model ScoreWeight {
  id                Int      @id @default(autoincrement())
  userId            String   @unique
  valuation         Int      @default(20)
  dividendYield     Int      @default(15)
  pl                Int      @default(10)
  roe               Int      @default(15)
  margins           Int      @default(10)
  debt              Int      @default(10)
  priceSafetyMargin Int      @default(10)
  dividendHistory   Int      @default(5)
  liquidity         Int      @default(3)
  governance        Int      @default(2)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("score_weights")
}

/// Parâmetros customizados por usuário/ativo para os métodos de valuation (Graham, Bazin, Lynch, DCF...).
model ValuationAssumption {
  id                   String          @id @default(cuid())
  userId               String
  assetId              String?
  method               ValuationMethod
  desiredDividendYield Decimal?        @db.Decimal(6, 2)
  marginOfSafety       Decimal?        @db.Decimal(6, 2)
  growthRate           Decimal?        @db.Decimal(6, 2)
  discountRate         Decimal?        @db.Decimal(6, 2)
  perpetuityGrowthRate Decimal?        @db.Decimal(6, 2)
  projectionYears      Int?
  grahamMultiplier     Decimal?        @db.Decimal(6, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId, method])
  @@map("valuation_assumptions")
}

// ============================================================
// ACOMPANHAMENTO
// ============================================================

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Favoritos")
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([userId, name])
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  assetId     String
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, assetId])
  @@map("watchlist_items")
}

model Alert {
  id          String              @id @default(cuid())
  userId      String
  assetId     String
  type        AlertType
  targetValue Decimal             @db.Decimal(18, 4)
  status      AlertStatus         @default(ACTIVE)
  triggeredAt DateTime?
  channel     NotificationChannel @default(EMAIL)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, status])
  @@map("alerts")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  alertId   String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@map("notifications")
}
